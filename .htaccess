
RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [L,R=301]

# 3. Redirect Redundant Pages to India/Domestic Versions (Default)
RewriteRule ^stretch-film\.html$ /india/stretch-film.html [L,R=301]
RewriteRule ^silage-film\.html$ /india/silage-film.html [L,R=301]

# 4. Remove index.html from URLs (Main Homepage)
RewriteCond %{THE_REQUEST} ^.*/index\.html
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]
