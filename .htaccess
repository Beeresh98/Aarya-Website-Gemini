
RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [L,R=301]

# 3. Redirect Redundant Pages to India/Domestic Versions (Default)
RewriteRule ^stretch-film\.html$ /india/stretch-film.html [L,R=301]
RewriteRule ^silage-film\.html$ /india/silage-film.html [L,R=301]

# 4. Remove index.html from URLs (Main Homepage)
RewriteCond %{THE_REQUEST} ^.*/index\.html
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# 5. Friendly "page not found" page
ErrorDocument 404 /404.html

# 6. Keep repository-only files off the web (git data, backups, notes, drafts)
RedirectMatch 404 ^/\.git
RedirectMatch 404 ^/(index_backup[^/]*\.html|implementation_plan\.md|smart_silage_film_calculator_app\.jsx|website.gemini.code\.txt|site-audit-[^/]*\.pdf)$
RedirectMatch 404 ^/silage-preview(/|$)

# 7. Security headers (safe for every folder, including /22-micron/ and the staff app)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 8. Speed: compress text files and let browsers cache images, CSS and JS
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
